{
  "name": "dsh-plugin-appstudio",
  "version": "0.1.11",
  "description": "Visual Android app workspace for DeepSeek Harness",
  "license": "MIT",
  "author": "nullutz",
  "homepage": "https://github.com/nullutz/dsh-plugin-appstudio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullutz/dsh-plugin-appstudio.git",
    "directory": "packages/appstudio"
  },
  "bugs": { "url": "https://github.com/nullutz/dsh-plugin-appstudio/issues" },
  "type": "module",
  "engines": { "dsh": "0.2.2-rc.1" },
  "exports": {
    ".": { "types": "./lib/types/host/index.d.ts", "default": "./lib/host.js" },
    "./android": { "types": "./lib/types/host/android.d.ts", "default": "./lib/android.js" },
    "./flutter": { "types": "./lib/types/host/flutter.d.ts", "default": "./lib/flutter.js" },
    "./react-native": { "types": "./lib/types/host/react-native.d.ts", "default": "./lib/react-native.js" },
    "./native-android": { "types": "./lib/types/host/native-android.d.ts", "default": "./lib/native-android.js" },
    "./commenting": { "types": "./lib/types/host/commenting.d.ts", "default": "./lib/commenting.js" },
    "./agent": { "types": "./lib/types/host/agent.d.ts", "default": "./lib/agent.js" },
    "./iterations": { "types": "./lib/types/host/iterations.d.ts", "default": "./lib/iterations.js" },
    "./layout": { "types": "./lib/types/host/layout.d.ts", "default": "./lib/layout.js" },
    "./prompt": { "types": "./lib/types/host/prompt.d.ts", "default": "./lib/prompt.js" },
    "./protocol": { "types": "./lib/types/shared/protocol.d.ts" },
    "./client": "./lib/client.js",
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [
      "@deepseek-ai/dsh-api-remotes",
      "@deepseek-ai/dsh-client-connection",
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-ui-layout",
      "@deepseek-ai/dsh-client-ui-renderer",
      "@deepseek-ai/dsh-client-ui-sidebar",
      "@deepseek-ai/dsh-client-ui-workspace"
    ] }
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/host.js",
    "lib/android.js",
    "lib/flutter.js",
    "lib/react-native.js",
    "lib/native-android.js",
    "lib/commenting.js",
    "lib/agent.js",
    "lib/iterations.js",
