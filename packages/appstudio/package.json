    "scaffold/flutter/android/build.gradle.kts",
    "scaffold/flutter/android/gradle.properties",
    "scaffold/flutter/android/settings.gradle.kts",
    "scaffold/flutter/assets/.gitkeep",
    "scaffold/flutter/lib/app_studio_scene.dart",
    "scaffold/flutter/lib/main.dart",
    "scaffold/flutter/pubspec.yaml",
    "scaffold/react-native/App.tsx",
    "scaffold/react-native/android/app/build.gradle",
    "scaffold/react-native/android/app/src/main/AndroidManifest.xml",
