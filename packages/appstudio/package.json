    "scaffold/react-native/android/app/src/main/res/values/styles.xml",
    "scaffold/react-native/android/build.gradle",
    "scaffold/react-native/android/gradle.properties",
    "scaffold/react-native/android/settings.gradle",
    "scaffold/react-native/babel.config.js",
    "scaffold/react-native/index.js",
    "scaffold/react-native/metro.config.js",
    "scaffold/react-native/npm-lock.json",
    "scaffold/react-native/npm-package.json",
    "scaffold/react-native/src/app-studio-scene.ts",
    "scaffold/react-native/tsconfig.json"
  ],
  "dependencies": {
    "diff": "9.0.0",
    "tar": "7.5.22",
    "ws": "8.22.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
